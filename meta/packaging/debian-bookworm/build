#!/usr/bin/env bash
set -euo pipefail

rm -rf .cutekit/venv
rm -rf .cutekit/tools-ready

podman run \
    --rm \
    -v "$PWD:/src" \
    -w "/src" \
    -e CUTEKIT_ALLOW_ROOT=1 \
    debian:bookworm \
    bash -c " \
        NO_URING=1 ./ck tools setup && \
        mkdir -p /src/dist && \
        ./ck package --props:async=epoll --release --layout=deb --prefix=/opt/${COMPONENT} --staging=/deb --maintainer='Odoo S.A. <info@odoo.com>' --output=/src/dist/${COMPONENT}_${VERSION}_bookworm_amd64.deb ${COMPONENT}"

# Check if installing the package works
podman run --rm -v "$PWD:/src" \
    -w "/src" \
    debian:bookworm \
    bash -c " \
        apt update && \
        apt install -y /src/dist/${COMPONENT}_${VERSION}_bookworm_amd64.deb && \
        /opt/${COMPONENT}/bin/${COMPONENT} --version && \
        /opt/${COMPONENT}/bin/${COMPONENT} /src/readme.md -o /tmp/output.pdf && \
        test -f /tmp/output.pdf"
